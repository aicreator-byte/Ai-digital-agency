# Salin file ini jadi .env lalu isi dengan value asli. Jangan commit .env ke git.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

GOOGLE_MAPS_API_KEY=

DEFAULT_INVOICE_DUE_DAYS=3

## Hosting: Cloudflare Pages (token dari vault custom.cloudflare, bukan .env)

DEFAULT_MAX_REVISIONS=5
STAGING_BASE_URL=http://localhost:8080/staging

# Gambar QRIS/DANA statis yang dikirim ke klien
DANA_QRIS_IMAGE_PATH=assets/qris_dana.jpeg

# WhatsApp (nomor khusus jualan, lihat whatsapp/README.md)
WA_ENABLED=false
WA_BRIDGE_URL=http://127.0.0.1:3000
WA_BRIDGE_TOKEN=
WA_WEBHOOK_PORT=8081
WA_DAILY_LIMIT=15
